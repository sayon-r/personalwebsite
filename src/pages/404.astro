---
import Base from '../layouts/Base.astro';
---
<Base title="Not found">
  <section class="intro">
    <div class="label code">0x194 · page fault</div>
    <h1>Not found</h1>
    <p class="sub">That address doesn't map to anything here. <a href="/">Back home →</a></p>
  </section>
</Base>

<style>
  .code { color: var(--accent); margin-bottom: 20px; }
  a { color: var(--text); border-bottom: 1px solid var(--accent); }
</style>
