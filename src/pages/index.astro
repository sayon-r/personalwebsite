---
import Base from '../layouts/Base.astro';
import SystolicArray from '../components/SystolicArray.astro';
import TimingDiagram from '../components/TimingDiagram.astro';
import Listening from '../components/Listening.astro';
import { site } from '../data/site';
---
<Base>
  <section class="hero">
    <h1>{site.name}</h1>
    <div class="row">
      <div class="copy">
        <p>
          Passionate about building high performance systems at the intersection of
          <span class="accent">hardware and software</span>.
        </p>
        <p>
          Currently working on <span class="accent">neural network accelerators</span> and
          <span class="accent">chip infrastructure</span> at onsemi.
        </p>
      </div>
      <SystolicArray />
    </div>
  </section>

  <TimingDiagram />
  <Listening />
</Base>

<style>
  .hero { margin-top: clamp(72px, 10vw, 128px); }
  h1 {
    margin: 0;
    font-size: clamp(56px, 10.5vw, 112px);
    line-height: 0.9;
    font-weight: 600;
    letter-spacing: -0.055em;
    color: var(--text);
  }
  .row {
    margin-top: 40px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 48px 56px;
  }
  .copy { flex: 1 1 420px; min-width: 0; }
  .copy p {
    margin: 0;
    max-width: 600px;
    font-size: clamp(21px, 2.6vw, 28px);
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--text);
  }
  .copy p + p { margin-top: 24px; }
</style>
