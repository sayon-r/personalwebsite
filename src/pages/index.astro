---
import Base from '../layouts/Base.astro';
import Listening from '../components/Listening.astro';
import { links } from '../data/site';

const index = [
  { href: '/experience', addr: '0x01', name: 'experience', desc: 'onsemi, portable intelligence', color: 'butter' },
  { href: '/projects', addr: '0x02', name: 'projects', desc: 'speculative decoding, flash attention', color: 'mint' },
  { href: '/blog', addr: '0x03', name: 'blog', desc: 'musings from work and personal research', color: 'pink' },
];
---
<Base page="home">
  <section class="hero">
    <h1>sayon ramanan<span class="cursor" aria-hidden="true"></span></h1>
    <p>
      passionate about building high performance systems at the intersection of
      <span class="hl lav">hardware and software</span>.
    </p>
    <p>
      currently working on <span class="hl mint">neural network accelerators</span> and
      <span class="hl peach">chip infrastructure</span> at onsemi.
    </p>
    <div class="links">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </div>
  </section>

  <section class="index">
    <div class="label">index</div>
    {index.map((row) => (
      <a href={row.href}>
        <span class="mono addr">{row.addr}</span>
        <span class="chip" style={`background:var(--${row.color})`}></span>
        <span class="name">{row.name}</span>
        <span class="desc">{row.desc}</span>
        <span aria-hidden="true">→</span>
      </a>
    ))}
  </section>

  <Listening />
</Base>

<style>
  .hero { margin-top: 112px; }
  h1 { margin: 0; font-size: 34px; line-height: 1.15; font-weight: 500; letter-spacing: -0.02em; }
  .cursor {
    display: inline-block;
    width: 14px;
    height: 28px;
    margin-left: 8px;
    border-radius: 3px;
    background: var(--lav);
    vertical-align: -3px;
    animation: blink 1.2s steps(1) infinite;
  }
  @keyframes blink { 50% { opacity: 0; } }
  p { margin: 14px 0 0; font-size: 19px; line-height: 1.65; color: var(--text-2); }
  h1 + p { margin-top: 24px; }
  .links { margin-top: 28px; display: flex; flex-wrap: wrap; gap: 8px 22px; font-size: 16px; }

  .index { margin-top: 80px; }
  .index a {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 18px;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }
  .index a:hover .name { text-decoration: underline; text-decoration-color: var(--lav); }
  .addr { font-size: 12px; color: var(--muted); }
  .chip { width: 10px; height: 10px; flex-basis: 10px; }
  .name { font-size: 18px; font-weight: 500; }
  .desc { flex: 1 1 200px; font-size: 16px; color: var(--muted); }
</style>
