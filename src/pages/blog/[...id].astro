---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const date = post.data.date.toLocaleDateString('en-CA', {
  year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC',
});
---
<Base page="blog" title={post.data.title} description={post.data.summary}>
  <article>
    <a class="back mono" href="/blog">← blog</a>
    <h1>{post.data.title}</h1>
    <div class="mono date">{date}</div>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  article { margin-top: 80px; }
  .back { font-size: 12px; text-decoration: none; color: var(--muted); }
  h1 { margin: 20px 0 0; font-size: 30px; line-height: 1.2; font-weight: 500; letter-spacing: -0.02em; text-transform: none; }
  .date { margin-top: 12px; font-size: 12px; color: var(--muted); }

  /* Posts keep normal capitalization */
  .prose { margin-top: 40px; font-size: 17px; line-height: 1.75; color: var(--text-2); text-transform: none; }
  .prose :global(h2) { margin: 44px 0 0; font-size: 22px; font-weight: 500; color: var(--text); }
  .prose :global(h3) { margin: 32px 0 0; font-size: 18px; font-weight: 500; color: var(--text); }
  .prose :global(p) { margin: 20px 0 0; }
  .prose :global(code) { font-family: var(--mono); font-size: 0.88em; color: var(--lav-t); background: rgba(var(--lav-rgb), 0.1); padding: 2px 5px; border-radius: 4px; }
  .prose :global(pre) { margin: 24px 0 0; padding: 18px 20px; overflow-x: auto; border: 1px solid var(--line); border-radius: 8px; background: #0c0d14 !important; font-size: 14px; line-height: 1.6; }
  .prose :global(pre code) { background: none; padding: 0; color: inherit; }
  .prose :global(blockquote) { margin: 24px 0 0; padding-left: 16px; border-left: 3px solid var(--lav); color: var(--muted); }
  .prose :global(img) { max-width: 100%; border-radius: 8px; }
  .prose :global(ul), .prose :global(ol) { margin: 20px 0 0; padding-left: 22px; }
</style>
