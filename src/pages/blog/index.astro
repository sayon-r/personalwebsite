---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const colors = ['pink', 'lav', 'mint', 'butter', 'sky', 'peach'];
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmt = (d: Date) => `${d.getUTCFullYear()}.${String(d.getUTCMonth() + 1).padStart(2, '0')}`;
---
<Base page="blog" title="Blog" description="Musings from work and personal research.">
  <section class="intro">
    <h1>blog</h1>
    <p>musings from <span class="hl pink">work</span> and <span class="hl lav">personal research</span>.</p>
  </section>

  <section class="list">
    {posts.length === 0 && <p class="empty">first post coming soon.</p>}
    {posts.map((post, i) => (
      <a href={`/blog/${post.id}`}>
        <span class="chip" style={`background:var(--${colors[i % colors.length]})`}></span>
        <span class="body">
          <span class="title">{post.data.title}</span>
          <span class="summary">{post.data.summary}</span>
        </span>
        <span class="mono date">{fmt(post.data.date)}</span>
      </a>
    ))}
  </section>
</Base>

<style>
  a { display: flex; gap: 18px; padding: 24px 0; border-bottom: 1px solid var(--line); text-decoration: none; }
  a:hover .title { text-decoration: underline; text-decoration-color: var(--lav); }
  .chip { margin-top: 7px; }
  .body { flex: 1; min-width: 0; }
  .title { display: block; font-size: 19px; font-weight: 500; line-height: 1.35; }
  .summary { display: block; margin-top: 6px; font-size: 16px; color: var(--muted); }
  .date { flex: 0 0 auto; font-size: 12px; color: var(--muted); padding-top: 5px; }
  .empty { padding: 24px 0; font-size: 16px; color: var(--muted); margin: 0; }
</style>
