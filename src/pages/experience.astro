---
import Base from '../layouts/Base.astro';
import KeepCase from '../components/KeepCase.astro';
import { experience } from '../data/site';
---
<Base page="experience" title="Experience">
  <section class="intro">
    <h1>experience</h1>
    <p>
      engineering work across <span class="hl butter">ml systems</span>,
      <span class="hl mint"><span class="keep">SoC</span> infrastructure</span>, and
      <span class="hl sky">recommendation systems</span>.
    </p>
  </section>

  <section class="list">
    {experience.map((job) => (
      <article>
        <span class="chip" style={`background:var(--${job.color})`}></span>
        <div class="body">
          <div class="top">
            <h2>{job.company}</h2>
            <span class="mono when">{job.period}</span>
          </div>
          <div class="role"><KeepCase text={`${job.role}, ${job.team} · ${job.location}`} /></div>
          <p><KeepCase text={job.summary} /></p>
        </div>
      </article>
    ))}
  </section>
</Base>

<style>
  article { display: flex; gap: 18px; padding: 28px 0; border-bottom: 1px solid var(--line); }
  .chip { margin-top: 8px; }
  .body { flex: 1; min-width: 0; }
  .top { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 4px 16px; }
  h2 { margin: 0; font-size: 20px; font-weight: 500; }
  .when { font-size: 12px; color: var(--muted); }
  .role { margin-top: 4px; font-size: 16px; color: var(--muted); }
  p { margin: 12px 0 0; font-size: 16px; line-height: 1.65; color: var(--text-2); }
</style>
