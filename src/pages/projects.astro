---
import Base from '../layouts/Base.astro';
import SpecDecode from '../components/figures/SpecDecode.astro';
import FlashAttn from '../components/figures/FlashAttn.astro';
import { projects } from '../data/site';

const figures = { specdecode: SpecDecode, flashattn: FlashAttn } as const;
---
<Base page="projects" title="Projects">
  <section class="intro">
    <h1>projects</h1>
    <p>
      small systems built to understand how <span class="hl mint">fast inference</span>
      actually works, one layer at a time.
    </p>
  </section>

  <section class="list">
    {projects.map((p) => {
      const Figure = figures[p.figure];
      return (
        <article>
          <figure><Figure /></figure>
          <div class="body">
            <div class="top">
              <h2>{p.name}</h2>
              <a href={p.href}>source ↗</a>
            </div>
            <div class="mono tag">{p.tag}</div>
            <p>{p.summary}</p>
            <div class="mono stack">{p.stack}</div>
          </div>
        </article>
      );
    })}
  </section>
</Base>

<style>
  article { display: flex; flex-wrap: wrap; gap: 16px 28px; padding: 32px 0; border-bottom: 1px solid var(--line); }
  figure { margin: 0; flex: 0 0 96px; display: flex; align-items: center; }
  .body { flex: 1 1 360px; min-width: 0; }
  .top { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 4px 16px; }
  h2 { margin: 0; font-size: 20px; font-weight: 500; }
  .top a { font-size: 15px; }
  .tag, .stack { font-size: 12px; color: var(--muted); }
  .tag { margin-top: 4px; }
  .stack { margin-top: 10px; }
  p { margin: 12px 0 0; font-size: 16px; line-height: 1.65; color: var(--text-2); }
</style>
