---
import { listening } from '../data/site';
---
<section class="listening">
  <div class="label">listening</div>
  <div class="row">
    {listening.cover
      ? <img class="art" src={listening.cover} alt="" width="44" height="44" />
      : <div class="art" style="background:var(--lav)"></div>}
    <div class="meta">
      <div class="track">{listening.track}</div>
      <div class="artist">{listening.artist}</div>
    </div>
    <ul class="shelf" aria-label="Albums on repeat">
      {listening.shelf.map((a) => (
        <li title={a.title}>
          {a.cover
            ? <img src={a.cover} alt={a.title} width="32" height="32" />
            : <span style={`background:var(--${a.color})`}></span>}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .listening { margin-top: 64px; }
  .row { margin-top: 16px; display: flex; flex-wrap: wrap; align-items: center; gap: 14px 16px; }
  .art { width: 44px; height: 44px; border-radius: 8px; object-fit: cover; }
  .meta { flex: 1 1 200px; }
  .track { font-size: 16px; font-weight: 500; }
  .artist { font-size: 15px; color: var(--muted); }
  .shelf { list-style: none; margin: 0; padding: 0; display: flex; gap: 6px; }
  .shelf img, .shelf span { display: block; width: 32px; height: 32px; border-radius: 6px; object-fit: cover; }
</style>
