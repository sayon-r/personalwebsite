---
// 4×7 attention tiles: finished, the current one, and queued.
const tiles = Array.from({ length: 28 }, (_, i) => ({
  x: (i % 7) * 14,
  y: Math.floor(i / 7) * 14,
  fill: i < 10 ? 'var(--lav)' : i === 10 ? '#f3f3f8' : '#272938',
}));
---
<svg width="96" height="54" viewBox="0 0 96 54" role="img" aria-label="Attention computed tile by tile, current tile highlighted">
  {tiles.map((t) => <rect x={t.x} y={t.y} width="11" height="11" rx="2.5" style={`fill:${t.fill}`} />)}
</svg>
