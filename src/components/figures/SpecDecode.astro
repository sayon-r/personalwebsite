---
// Two prompt tokens, three accepted drafts, one rejected, one corrected.
const tokens = ['#2d2f40', '#2d2f40', 'var(--mint)', 'var(--mint)', 'var(--mint)', 'var(--peach)', '#f3f3f8'];
---
<svg width="96" height="40" viewBox="0 0 96 40" role="img" aria-label="Draft tokens: accepted, rejected, corrected">
  {tokens.map((c, i) => <rect x={i * 14} y="14" width="11" height="11" rx="2.5" style={`fill:${c}`} />)}
</svg>
