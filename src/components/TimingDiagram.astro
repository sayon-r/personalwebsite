---
// Logic-analyzer style divider. The data bus spells 0x53 0x52 0x21 = "SR!".
let clk = 'M60 28';
for (let x = 60; x < 984; x += 27) {
  clk += ` H${Math.min(x + 13.5, 984)} V12 H${Math.min(x + 27, 984)} V28`;
}
---
<div class="timing hide-sm" aria-hidden="true">
  <svg width="100%" viewBox="0 0 984 112" preserveAspectRatio="xMinYMid meet">
    <g class="lbl">
      <text x="0" y="22">clk</text><text x="0" y="56">valid</text><text x="0" y="90">data</text>
    </g>
    <path d={clk} class="sig" />
    <path d="M60 62 H392 L398 46 H714 L720 62 H984" class="sig" />
    <path d="M398 46 H714" class="hi" />
    <g class="sig">
      <path d="M60 80 H392 L398 88 L392 96 H60" />
      <path d="M398 88 L404 80 H500 L506 88 L500 96 H404 Z" />
      <path d="M506 88 L512 80 H608 L614 88 L608 96 H512 Z" />
      <path d="M614 88 L620 80 H708 L714 88 L708 96 H620 Z" />
      <path d="M714 88 L720 80 H984 M720 96 H984 M714 88 L720 96" />
    </g>
    <g class="bus">
      <text x="226" y="91">idle</text><text x="452" y="91">0x53</text><text x="560" y="91">0x52</text>
      <text x="664" y="91">0x21</text><text x="850" y="91">idle</text>
    </g>
    <path d="M560 4 V108" class="cursor" />
    <text x="566" y="10" class="t1">T1</text>
  </svg>
</div>

<style>
  .timing { margin-top: 96px; }
  svg { display: block; overflow: visible; }
  .lbl text { font-family: var(--mono); font-size: 10px; fill: var(--text-4); }
  .sig, .sig path { fill: none; stroke: rgba(233, 230, 223, 0.35); stroke-width: 1; }
  .hi { fill: none; stroke: var(--accent); stroke-width: 1.5; }
  .bus text { font-family: var(--mono); font-size: 9px; fill: var(--text-3); text-anchor: middle; }
  .cursor { stroke: var(--accent); stroke-dasharray: 2 3; opacity: 0.7; }
  .t1 { font-family: var(--mono); font-size: 9px; fill: var(--accent); }
</style>
