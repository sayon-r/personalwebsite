---
// Gold contact fingers along the bottom of every page, like a PCB edge.
---
<div class="edge" aria-hidden="true">
  <svg width="100%" height="96">
    <defs>
      <pattern id="fingers" width="26" height="96" patternUnits="userSpaceOnUse">
        <path d="M13 0 V34" stroke="rgba(233,230,223,0.16)" stroke-width="1" />
        <circle cx="13" cy="36" r="2.5" fill="none" stroke="rgba(233,230,223,0.22)" />
        <rect x="6" y="48" width="14" height="48" rx="2" style="fill: var(--accent); fill-opacity: 0.22" />
      </pattern>
    </defs>
    <rect width="100%" height="96" fill="url(#fingers)" />
    <rect y="95" width="100%" height="1" style="fill: var(--accent); fill-opacity: 0.4" />
  </svg>
</div>

<style>
  .edge {
    height: 96px;
    -webkit-mask-image: linear-gradient(to top, #000 40%, transparent);
    mask-image: linear-gradient(to top, #000 40%, transparent);
  }
  svg { display: block; }
</style>
